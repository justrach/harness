  "actionScenarios": [
    {
      "name": "a removal is applied only after the host acknowledges it",
      "texts": [
        "first",
        "second"
      ],
      "target": "first",
      "action": "remove",
      "reply": {
        "removed": true
      },
      "expectOk": true,
      "expectTexts": [
        "second"
      ],
      "expectError": null
    },
    {
      "name": "a refused removal keeps the row and says so",
      "texts": [
        "keep me"
      ],
      "target": "keep me",
      "action": "remove",
      "reply": {
        "removed": false
      },
      "expectOk": false,
      "expectTexts": [
        "keep me"
      ],
      "expectError": "The host did not confirm the action. The message may have already left the queue."
    },
    {
      "name": "a reply for the wrong action does not count",
      "texts": [
        "keep me"
      ],
      "target": "keep me",
      "action": "remove",
      "reply": {
        "sent": true
      },
      "expectOk": false,
      "expectTexts": [
        "keep me"
      ],
      "expectError": "The host did not confirm the action. The message may have already left the queue."
    },
    {
      "name": "a lost connection during a removal keeps the row",
      "texts": [
        "keep me"
      ],
      "target": "keep me",
      "action": "remove",
      "reply": "throw",
      "expectOk": false,
      "expectTexts": [
        "keep me"
      ],
      "expectError": "Couldn't complete remove. Check the connection to the chat host and the queue before retrying."
    },
    {
      "name": "send now leaves the projection to sync",
      "texts": [
        "hello"
      ],
      "target": "hello",
      "action": "sendNow",
      "reply": {
        "sent": true
      },
      "expectOk": true,
      "expectTexts": [
        "hello"
      ],
      "expectError": null
    },
    {
      "name": "a lost connection during send now surfaces an error",
      "texts": [
        "hello"
      ],
      "target": "hello",
      "action": "sendNow",
      "reply": "throw",
      "expectOk": false,
      "expectTexts": [
        "hello"
      ],
      "expectError": "Couldn't complete send now. Check the connection to the chat host and the queue before retrying."
    },
    {
      "name": "a protected row cannot be sent, even by a direct call",
      "texts": [
        "protected"
      ],
      "target": "protected",
      "action": "sendNow",
      "gate": "reviewRequired",
      "reply": {
        "sent": true
      },
      "expectCalled": false,
      "expectOk": false,
      "expectTexts": [
        "protected"
      ],
      "expectError": null
    },
    {
      "name": "a protected row can still be removed",
      "texts": [
        "protected"
      ],
      "target": "protected",
      "action": "remove",
      "gate": "editing",
      "reply": {
        "removed": true
      },
      "expectCalled": true,
      "expectOk": true,
      "expectTexts": [],
      "expectError": null
    }
  ],
  "inFlight": {
    "texts": [
      "first",
      "second"
    ],
    "target": "first",
    "expectMethod": "RemoveQueuedMessage",
    "expectTextsDuringCall": [
      "first",
      "second"
    ],
    "expectPendingDuringCall": true,
    "expectTextsAfter": [
      "second"
    ]
  }
}
