          {
            "id": "graff",
            "status": "missing",
            "devices": []
          },
          {
            "id": "claude-code",
            "status": "missing",
            "devices": []
          },
          {
            "id": "codex",
            "status": "missing",
            "devices": []
          }
        ]
      }
    },
