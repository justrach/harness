<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the performance report wait for an unmetered network instead of waking the mobile radio. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="Harness"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harness">
        <!--
          Resizable on every axis and handles size, density and posture changes in
          place, so folding, unfolding, rotation and split-screen never recreate
          the activity or lose the open session and draft.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              CodeGraff sign-in comes back here: the edge's app callback forwards the code to
              harness://callback, as for the iOS app. singleTask returns the browser to this
              task instead of starting a second copy of the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="harness" android:host="callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
