    {"name": "watch the checkout diffs", "method": "WatchCheckoutDiffs", "stream": true, "params": {}},
    {"name": "the working tree's diff", "method": "GetCheckoutDiff", "stream": false, "params": {"cwd":"$DIR","mode":"workingTree"}},
