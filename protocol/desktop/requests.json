    {"name": "search files", "method": "SearchWorkspaceFiles", "stream": false, "params": {"chatId":"chat-parity","query":"readme","includeIgnored":true,"limit":200}},
    {"name": "read a file", "method": "ReadWorkspaceFile", "stream": false, "params": {"chatId":"chat-parity","path":"README.md"}},
    {"name": "watch git", "method": "WatchWorkspaceGitStatus", "stream": true, "params": {"spaceId":"space-parity","checkoutPath":"$DIR"}},
    {"name": "list project actions", "method": "ListProjectActions", "stream": false, "params": {"spaceId":"space-parity"}},
    {"name": "run a project action", "method": "RunProjectAction", "stream": false, "params": {"spaceId":"space-parity","chatId":"chat-parity","actionId":"test","cols":80,"rows":24}},
    {"name": "add a project action", "method": "UpsertProjectAction", "stream": false, "params": {"spaceId":"space-parity","action":{"name":"Test","command":"echo hi","icon":"test","runOnWorktreeCreate":false}}},
    {"name": "change a project action", "method": "UpsertProjectAction", "stream": false, "params": {"spaceId":"space-parity","actionId":"test","action":{"name":"Test","command":"echo hello","icon":"play","runOnWorktreeCreate":true}}},
    {"name": "watch a terminal", "method": "SubscribeTerminal", "stream": true, "params": {"terminalId":"terminal-parity"}},
    {"name": "close a terminal", "method": "CloseTerminal", "stream": false, "params": {"terminalId":"terminal-parity"}},
    {"name": "delete a project action", "method": "DeleteProjectAction", "stream": false, "params": {"spaceId":"space-parity","actionId":"test"}},
    {"name": "merge a Graff worktree back", "method": "GraffWorktreeAction", "stream": false, "params": {"chatId":"chat-parity","action":"merge"}},
    {"name": "watch a branch's pull request", "method": "WatchCheckoutChangeRequest", "stream": true, "params": {"cwd":"$DIR","branch":"main"}},
    {"name": "merge a branch's pull request", "method": "MergeChangeRequest", "stream": false, "params": {"cwd":"$DIR","branch":"main","number":90}}
  ]
