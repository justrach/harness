{
  "comment": "Every request harness-nano sends the engine, written by `zig build vectors` (apps/nano/src/parity_requests.zig) from the builders the app sends them with. The Zig runner checks the builders still produce exactly these; the Rust runner (crates/engine/tests/desktop_requests.rs) sends each, in order, to a real engine and fails on bad params or an unknown method. $DEVICE and $DIR are the engine's device id and the project's folder.",
  "requests": [
    {"name": "create a project", "method": "Mutate", "stream": false, "params": {"op":"createSpace","spaceId":"space-parity","deviceId":"$DEVICE","path":"$DIR","gitDetected":false}},
    {"name": "create a chat", "method": "Mutate", "stream": false, "params": {"op":"createChat","chatId":"chat-parity","spaceId":"space-parity","config":{"harness":"mock","modelOptions":{},"sandbox":"workspace-write"}}},
    {"name": "engine info", "method": "EngineInfo", "stream": false, "params": {}},
    {"name": "engine ready", "method": "EngineReady", "stream": false, "params": {}},
    {"name": "list agents", "method": "ListHarnesses", "stream": false, "params": {}},
    {"name": "list models", "method": "ListModels", "stream": false, "params": {"harness":"mock"}},
    {"name": "watch spaces", "method": "WatchSpaces", "stream": true, "params": {}},
    {"name": "watch chats", "method": "WatchChats", "stream": true, "params": {}},
    {"name": "watch sessions", "method": "WatchSessions", "stream": true, "params": {}},
    {"name": "watch devices", "method": "WatchDevices", "stream": true, "params": {}},
    {"name": "focus a chat", "method": "FocusChat", "stream": false, "params": {"chatId":"chat-parity"}},
    {"name": "mark a chat seen", "method": "Mutate", "stream": false, "params": {"op":"markChatSeen","chatId":"chat-parity"}},
    {"name": "watch a transcript", "method": "WatchDocMessages", "stream": true, "params": {"chatId":"chat-parity","openingTail":true}},
    {"name": "set a chat's config", "method": "Mutate", "stream": false, "params": {"op":"setChatConfig","chatId":"chat-parity","config":{"harness":"mock","reasoning":"medium","modelOptions":{},"sandbox":"workspace-write"}}},
    {"name": "archive a chat", "method": "Mutate", "stream": false, "params": {"op":"setChatArchived","chatId":"chat-parity","archived":true}},
    {"name": "unarchive a chat", "method": "Mutate", "stream": false, "params": {"op":"setChatArchived","chatId":"chat-parity","archived":false}},
    {"name": "run a prompt", "method": "QueueCommand", "stream": false, "params": {"chatId":"chat-parity","command":{"kind":"run","messageId":"11111111-0000-4000-8000-000000000001","request":{"prompt":"Add rate limiting","turnOrigin":"human","harness":"mock","modelOptions":{},"cwd":"$DIR","sandbox":"workspace-write","autoApprove":false}}}},
    {"name": "stop the run", "method": "QueueCommand", "stream": false, "params": {"chatId":"chat-parity","command":{"kind":"interrupt"}}},
    {"name": "answer a question", "method": "QueueCommand", "stream": false, "params": {"chatId":"chat-parity","command":{"kind":"respondInput","requestId":"req-parity","answers":[{"questionId":"q1","labels":["Event-driven"]},{"questionId":"q2","labels":["Unit","E2E"]}]}}},
    {"name": "dismiss a question", "method": "QueueCommand", "stream": false, "params": {"chatId":"chat-parity","command":{"kind":"dismissInput","requestId":"req-parity"}}},
    {"name": "watch the queue", "method": "WatchQueue", "stream": true, "params": {"chatId":"chat-parity"}},
    {"name": "queue a message", "method": "QueueMessage", "stream": false, "params": {"chatId":"chat-parity","text":"Then update the changelog","holdForTurnEnd":true}},
    {"name": "remove a queued message", "method": "RemoveQueuedMessage", "stream": false, "params": {"chatId":"chat-parity","id":"row-parity"}},
    {"name": "send a queued message now", "method": "SendQueuedMessageNow", "stream": false, "params": {"chatId":"chat-parity","id":"row-parity"}},
    {"name": "begin editing a queued message", "method": "BeginQueuedMessageEdit", "stream": false, "params": {"chatId":"chat-parity","id":"row-parity","editorDeviceId":"$DEVICE","editorInstanceId":"22222222-0000-4000-8000-000000000002"}},
