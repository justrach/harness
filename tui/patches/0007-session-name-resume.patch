diff --git a/codex-rs/tui/src/resume_picker/selection.rs b/codex-rs/tui/src/resume_picker/selection.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/tui/src/resume_picker/selection.rs
@@ -0,0 +1,112 @@
+//! Keyboard and mouse share the same session selection and rendered-row geometry.
+
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Position;
+use ratatui::layout::Rect;
+use ratatui::layout::Size;
+
+use super::PickerState;
+use super::SessionSelection;
+use super::SessionStatus;
+use super::SessionTarget;
+use super::archive;
+use super::layout;
+use super::list_viewport_width;
+
+impl PickerState {
+    pub(super) fn accept_selected(&mut self) -> Option<SessionSelection> {
+        let row = self.filtered_rows.get(self.selected)?;
+        let path = row.path.clone();
+        if let Some(thread_id) = row.thread_id {
+            if self.status == SessionStatus::Archived {
+                self.request_unarchive(thread_id);
+                return None;
+            }
+            return Some(self.action.selection(SessionTarget {
+                path,
+                thread_id,
+                cwd: row.cwd.clone(),
+                history_mode: self.thread_history_modes.get(&thread_id).copied(),
+            }));
+        }
+        self.inline_error = Some(match path {
+            Some(path) => format!("Failed to read session metadata from {}", path.display()),
+            None => String::from("Failed to read session metadata from selected session"),
+        });
+        self.request_frame();
+        None
+    }
+
+    pub(super) fn handle_mouse(
+        &mut self,
+        mouse: MouseEvent,
+        size: Size,
+    ) -> Option<SessionSelection> {
+        if !matches!(self.archive_state, archive::ArchiveState::Idle)
+            || self.is_transcript_loading()
+        {
+            return None;
+        }
+        let list = layout::areas(Rect::from(size)).list;
+        let list = Rect::new(
+            list.x.saturating_add(2),
+            list.y,
+            list_viewport_width(list.width),
+            list.height,
+        );
+        if !list.contains(Position::new(mouse.column, mouse.row)) {
+            return None;
+        }
+        match mouse.kind {
+            MouseEventKind::Down(MouseButton::Left) => {
+                self.selected = self.row_at(list, mouse.row)?;
+                self.accept_selected()
+            }
+            MouseEventKind::ScrollUp => {
+                self.selected = self.selected.saturating_sub(1);
+                self.ensure_selected_visible();
+                self.request_frame();
+                None
+            }
+            MouseEventKind::ScrollDown => {
+                self.selected = self
+                    .selected
+                    .saturating_add(1)
+                    .min(self.filtered_rows.len().saturating_sub(1));
+                self.ensure_selected_visible();
+                self.maybe_load_more_for_scroll();
+                self.request_frame();
+                None
+            }
+            _ => None,
+        }
+    }
+
+    fn row_at(&self, area: Rect, y: u16) -> Option<usize> {
+        let first = area.y.saturating_add(u16::from(self.has_more_above()));
+        let end = area
+            .bottom()
+            .saturating_sub(u16::from(self.has_more_below(area.height as usize)));
+        if y < first || y >= end {
+            return None;
+        }
+        let mut top = usize::from(first);
+        for index in self.scroll_top..self.filtered_rows.len() {
+            let height = self.rendered_height_between(index, index);
+            if usize::from(y) < top + height {
+                return Some(index);
+            }
+            top += height + self.row_separator_height();
+            if usize::from(y) < top {
+                return None; // Decorative space is not a session.
+            }
+        }
+        None
+    }
+}
