+use super::*;
+use crate::resume_picker::ProviderFilter;
+use crate::resume_picker::Row;
+use crate::resume_picker::SessionListDensity;
+use crate::resume_picker::SessionPickerAction;
+use crate::tui::FrameRequester;
+use codex_protocol::ThreadId;
+use crossterm::event::KeyModifiers;
+use pretty_assertions::assert_eq;
+
+fn picker() -> PickerState {
+    let mut state = PickerState::new(
+        FrameRequester::test_dummy(),
+        std::sync::Arc::new(|_| {}),
+        ProviderFilter::Any,
+        /*show_all*/ true,
+        /*filter_cwd*/ None,
+        SessionPickerAction::Resume,
+    );
+    state.filtered_rows = [
+        "Fix session picker",
+        "Review parser changes",
+        "Continue the tests",
+    ]
+    .into_iter()
+    .map(|title| Row {
+        path: None,
+        preview: title.into(),
+        thread_name: Some(title.into()),
+        thread_id: Some(ThreadId::new()),
+        created_at: None,
+        updated_at: None,
+        cwd: Some("/project".into()),
+        git_branch: None,
+    })
+    .collect();
+    state.update_viewport(14, list_viewport_width(80));
+    state
+}
+
+fn click(x: u16, y: u16) -> MouseEvent {
+    MouseEvent {
+        kind: MouseEventKind::Down(MouseButton::Left),
+        column: x,
+        row: y,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+
+#[test]
+fn mouse_selects_the_same_named_session_as_keyboard() {
+    let mut state = picker();
+    let size = Size::new(80, 24);
+    let area = layout::areas(Rect::from(size)).list;
+    let second =
+        area.y + state.rendered_height_between(0, 0) as u16 + state.row_separator_height() as u16;
+    let mouse = state.handle_mouse(click(3, second), size);
+    assert_eq!(state.selected, 1);
+    let Some(SessionSelection::Resume(clicked)) = mouse else {
+        panic!("click must resume");
+    };
+    let Some(SessionSelection::Resume(keyboard)) = state.accept_selected() else {
+        panic!("Enter must resume");
+    };
+    assert_eq!(clicked.thread_id, keyboard.thread_id);
+    assert_eq!(clicked.cwd, keyboard.cwd);
+}
+
+#[test]
+fn mouse_ignores_chrome_gaps_and_more_indicators_in_both_densities() {
+    let mut state = picker();
+    let size = Size::new(80, 24);
+    let area = layout::areas(Rect::from(size)).list;
+    assert!(state.handle_mouse(click(0, area.y), size).is_none());
+    assert!(state.handle_mouse(click(3, 0), size).is_none());
+    let gap = area.y + state.rendered_height_between(0, 0) as u16;
+    assert!(state.handle_mouse(click(3, gap), size).is_none());
+    for density in [SessionListDensity::Comfortable, SessionListDensity::Dense] {
+        state.density = density;
+        state.scroll_top = 1;
+        state.selected = 1;
+        assert!(state.handle_mouse(click(3, area.y), size).is_none());
+        assert!(state.handle_mouse(click(3, area.y + 1), size).is_some());
+        assert_eq!(state.selected, 1);
+    }
+}
+
+#[test]
+fn named_resume_picker_snapshot() {
+    use crate::custom_terminal::Terminal;
+    use crate::test_backend::VT100Backend;
+
+    let state = picker();
+    let backend = VT100Backend::new(80, 24);
+    let mut terminal = Terminal::with_options(backend).expect("terminal");
+    terminal.set_viewport_area(Rect::new(0, 0, 80, 24));
+    layout::render(&mut terminal.get_frame(), &state);
+    terminal.flush().expect("flush");
+    let screen = terminal
+        .backend()
+        .to_string()
+        .lines()
+        .map(str::trim_end)
+        .collect::<Vec<_>>()
+        .join("\n");
+    insta::assert_snapshot!(screen);
+}
